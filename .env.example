# Local runs need none of this: the DuckDB target reads the files on disk.

# --- BigQuery target -------------------------------------------------------
# BQ_PROJECT=your-gcp-project
# BQ_DATASET=mta
# BQ_LOCATION=US
# BQ_METHOD=oauth          # or service-account, in production

# --- Overrides -------------------------------------------------------------
# Where the poller writes, and what the local warehouse is called. Both have
# sensible defaults; these exist so the container and the tests can redirect
# them without editing anything.
# MTA_OUT=/data/raw
# MTA_RAW_GLOB=../data/raw/**/*.ndjson.gz
# MTA_DUCKDB=../data/warehouse.duckdb
